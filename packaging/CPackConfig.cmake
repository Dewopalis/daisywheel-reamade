set(DAISYWHEEL_PACKAGE_VERSION "${PROJECT_VERSION}" CACHE STRING "Release package version")
if(NOT DAISYWHEEL_PACKAGE_VERSION MATCHES "^[0-9]+\\.[0-9]+\\.[0-9]+$")
  message(FATAL_ERROR "Package version must be numeric MAJOR.MINOR.PATCH")
endif()
set(CPACK_PACKAGE_NAME "daisywheel-reamade")
set(CPACK_PACKAGE_VERSION "${DAISYWHEEL_PACKAGE_VERSION}")
set(CPACK_PACKAGE_VENDOR "Daisywheel REAmade contributors")
set(CPACK_PACKAGE_CONTACT "https://github.com/Dewopalis/daisywheel-reamade/issues")
set(CPACK_PACKAGE_HOMEPAGE_URL "https://github.com/Dewopalis/daisywheel-reamade")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "Controller-first keyboard for KDE Wayland")
set(CPACK_PACKAGE_FILE_NAME "daisywheel-reamade-${CPACK_PACKAGE_VERSION}-${CMAKE_SYSTEM_PROCESSOR}")
set(CPACK_PACKAGING_INSTALL_PREFIX "/usr")
set(CPACK_DEBIAN_PACKAGE_MAINTAINER "Daisywheel REAmade contributors")
set(CPACK_DEBIAN_PACKAGE_SECTION "utils")
set(CPACK_DEBIAN_PACKAGE_SHLIBDEPS ON)
set(CPACK_DEBIAN_PACKAGE_DEPENDS "qt6-qpa-plugins, qt6-wayland, layer-shell-qt")
set(CPACK_DEBIAN_FILE_NAME DEB-DEFAULT)
set(CPACK_RPM_PACKAGE_LICENSE "GPL-3.0-only")
set(CPACK_RPM_USER_FILELIST "%license /usr/share/doc/daisywheel-reamade/LICENSE")
set(CPACK_RPM_PACKAGE_REQUIRES "qt6-qtbase-gui, qt6-qtwayland, layer-shell-qt")
set(CPACK_RPM_PACKAGE_AUTOREQPROV ON)
set(CPACK_RPM_FILE_NAME RPM-DEFAULT)
include(CPack)
